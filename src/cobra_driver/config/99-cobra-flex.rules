# Waveshare Cobra Flex ESP32-S3 — consistent /dev/cobra_flex symlink
# To install: sudo cp 99-cobra-flex.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules
# QinHeng USB Single Serial (CH343) — the data/feedback UART on the Cobra Flex hub
# NOTE: 303a:1001 is the ESP32-S3 JTAG debug port (ttyACM0), NOT used for robot comms.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", SYMLINK+="cobra_flex", MODE="0666"
